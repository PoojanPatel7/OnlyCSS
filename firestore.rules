rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'moderator']
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Styles Collection
    match /styles/{styleId} {
      // Anyone can view published styles.
      allow read: if true;
      
      // Only authenticated users can create a style
      allow create: if isAuthenticated() 
                    && request.resource.data.authorId == request.auth.uid;
                    
      // Owner can update/delete. Admins can also update/delete (moderation).
      allow update: if (isAuthenticated() 
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.authorId == request.auth.uid) 
                    || isAdmin();
                    
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) 
                    || isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;
      
      // Users can create their profile. Must be 'user' role by default.
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      
      // Super admin can update anything.
      // Moderators can update user data (ban) but cannot change roles.
      // Users can update their own data but cannot change their role or ban status.
      allow update: if isSuperAdmin() 
                    || (isAdmin() && request.resource.data.role == resource.data.role)
                    || (isOwner(userId) 
                        && request.resource.data.role == resource.data.role 
                        && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false));
      
      // Only Super Admins can delete users
      allow delete: if isSuperAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
